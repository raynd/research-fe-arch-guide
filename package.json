{
  "name": "frontend-architecture-geo-aeo-research",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "format:check": "prettier --check \"**/*.{astro,md,mdoc,yaml,yml}\"",
    "format": "prettier --write \"**/*.{astro,md,mdoc,yaml,yml}\"",
    "validate": "pnpm run lint && pnpm run format:check && pnpm run check && pnpm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
    "*.{astro,md,mdoc,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/markdoc": "2.1.2",
    "@astrojs/starlight": "0.42.8",
    "@astrojs/starlight-markdoc": "0.7.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
